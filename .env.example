# Server
PORT=3147
DB_PATH=./tokember.db
NODE_ENV=development

# Required as Docker build arguments for reproducible Compose releases.
# TOKEMBER_COMMIT=0123456789abcdef0123456789abcdef01234567
# TOKEMBER_BUILT_AT=2026-07-17T00:00:00.000Z

# Required in production. Used by collectors to register, ingest, and report runs.
TOKEMBER_API_KEY=change-me-to-a-long-random-string

# Required in production. Admin settings password.
TOKEMBER_ADMIN_PASSWORD=change-me-admin-password

# Optional. Signs the admin HttpOnly session cookie (defaults derived from password).
# TOKEMBER_ADMIN_SECRET=
# TOKEMBER_ADMIN_SECRET_PREVIOUS=

# Optional Viewer login. Unset keeps Dashboard/year/records compatible and public.
# TOKEMBER_VIEWER_PASSWORD=
# TOKEMBER_VIEWER_SECRET=
# TOKEMBER_VIEWER_SECRET_PREVIOUS=

# Optional security policy. Exact origins only; wildcard origins are rejected.
# TOKEMBER_AUTH_AUDIT_SECRET=
# TOKEMBER_CORS_ORIGINS=https://tokember.example
# TOKEMBER_TRUST_PROXY=false
# TOKEMBER_COOKIE_SAME_SITE=lax
# TOKEMBER_COOKIE_SECURE=auto
# Keep true during server-first device-token rollout, then set false.
# TOKEMBER_ALLOW_LEGACY_API_KEY=true

# Optional. Both values are required to enable signed generic alert webhooks.
# TOKEMBER_ALERT_WEBHOOK_URL=https://alerts.example/hook
# TOKEMBER_ALERT_WEBHOOK_SECRET=change-me-to-an-independent-random-secret

# Collectors
# TOKEMBER_SERVER=https://tokember.example
# TOKEMBER_DEVICE_ID=
# TOKEMBER_DEVICE_NAME=
# TOKEMBER_DEVICE_TOKEN=
# TOKEMBER_CLAUDE_CODEX_SOURCE=native
# TOKEMBER_COLLECTOR_STATE=
# TOKEMBER_OBSERVABILITY_STATE=
# TOKEMBER_SCHEDULE_INTERVAL_MINUTES=30
# TOKEMBER_CACHE_DIR=
# Privacy-first project/session attribution is opt-in. The secret is generated locally.
# TOKEMBER_ATTRIBUTION_ENABLED=false
# TOKEMBER_ATTRIBUTION_SECRET_FILE=
# ANTIGRAVITY_HOME=

# Hermes defaults (the installer writes canonical /var/lib paths and 60 minutes).
# TOKEMBER_STATE=/var/lib/tokember-hermes/state.json
# TOKEMBER_OBSERVABILITY_STATE=/var/lib/tokember-hermes/observability.json
# TOKEMBER_SCHEDULE_INTERVAL_MINUTES=60
# TOKEMBER_ATTRIBUTION_ENABLED=false
# TOKEMBER_ATTRIBUTION_SECRET_FILE=/var/lib/tokember-hermes/attribution-secret

# Migration aliases remain accepted: AI_BURN_API_KEY, AI_BURN_ADMIN_PASSWORD,
# AI_BURN_ADMIN_SECRET, AI_BURN_SERVER, AI_BURN_DEVICE_ID, AI_BURN_DEVICE_NAME,
# AI_BURN_CLAUDE_CODEX_SOURCE, AI_BURN_COLLECTOR_STATE,
# AI_BURN_OBSERVABILITY_STATE, AI_BURN_SCHEDULE_INTERVAL_MINUTES,
# AI_BURN_CACHE_DIR, AI_BURN_ATTRIBUTION_ENABLED,
# AI_BURN_ATTRIBUTION_SECRET_FILE.
