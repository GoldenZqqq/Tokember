{
  "name": "tokember",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22 <23" },
  "workspaces": ["contracts", "server", "collector", "web"],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:python && npm run test:release",
    "test:python": "python -m unittest discover -s collector -p \"test_*.py\"",
    "test:release": "node --test scripts/release.test.mjs scripts/runtime-gates.test.mjs scripts/public-export.test.mjs scripts/public-hygiene.test.mjs scripts/site.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "test:dist": "npm run test:dist -w collector",
    "test:e2e": "playwright test --grep-invert @screenshot",
    "test:site": "playwright test --config=scripts/site.playwright.config.ts",
    "demo:screenshot": "playwright test --project=desktop --grep @screenshot",
    "public:export": "node scripts/public-export.mjs",
    "public:verify": "node scripts/verify-public-export.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:installer-platform": "node scripts/verify-installer-platform.mjs",
    "verify": "npm run verify:runtime && npm run verify:installer-platform && npm run typecheck && npm test && npm run build && npm run test:dist",
    "collect": "npm run collect -w collector",
    "collector:install": "node collector/install.mjs install",
    "collector:doctor": "node collector/install.mjs doctor",
    "collector:uninstall": "node collector/install.mjs uninstall",
    "release:collector": "node scripts/package-collector-release.mjs",
    "release:image-manifest": "node scripts/package-image-manifest.mjs"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
