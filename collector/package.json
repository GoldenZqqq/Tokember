{
  "name": "@tokember/collector",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "collect": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --platform node --target node22",
    "test": "node scripts/run-tests.mjs",
    "test:dist": "node scripts/smoke-dist.mjs",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@tokember/contracts": "0.1.0",
    "tsx": "^4.19.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
